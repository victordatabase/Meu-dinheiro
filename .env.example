# Copie este arquivo para ".env" na raiz do projeto (frontend) se quiser
# conectar o app à API + MySQL, em vez do localStorage do navegador.
#
# Deixe o arquivo ".env" ausente (ou essas variáveis vazias) para manter
# o comportamento padrão salvando no navegador.

# URL pública da sua API (backend/), sem barra no final.
VITE_API_URL=https://sua-api.exemplo.com

# Mesma chave configurada em API_SECRET no backend/.env
VITE_API_SECRET=troque-por-uma-chave-aleatoria
