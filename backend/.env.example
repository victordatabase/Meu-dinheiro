# Copie este arquivo para ".env" e preencha com os dados reais.
# NUNCA envie o arquivo ".env" (com as senhas de verdade) para o GitHub.

PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=escolha-uma-senha
DB_NAME=meudinheiro
# ↑ use o nome do banco que você confirmou no TablePlus (rodando
#   "SHOW TABLES;" ele aparece na coluna "Tables_in_<nome_do_banco>")

# Endereço do site publicado no GitHub Pages (sem barra no final).
# Enquanto estiver testando local, pode deixar como http://localhost:5173
ALLOWED_ORIGIN=https://seu-usuario.github.io

# Uma chave qualquer, só para dificultar acesso de estranhos à API.
# Gere uma, por exemplo, em https://www.uuidgenerator.net/
API_SECRET=troque-por-uma-chave-aleatoria
